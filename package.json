{
	"name": "@xobotyi/scrollbar-width",
	"version": "1.9.5",
	"description": "A tool to get browser's scrollbars width.",
	"keywords": [
		"browser",
		"detect",
		"native",
		"scrollbar",
		"scrollbar-width",
		"width"
	],
	"homepage": "https://github.com/xobotyi/scrollbar-width",
	"bugs": {
		"url": "https://github.com/xobotyi/scrollbar-width/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Anton Zinovyev",
		"email": "xog3@yandex.ru",
		"url": "https://github.com/xobotyi"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/xobotyi/scrollbar-width.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "yarn build:cleanup && yarn build:tsc",
		"build:cleanup": "rimraf ./dist",
		"build:tsc": "tsc -p ./tsconfig.build.json",
		"test": "vp test",
		"test:coverage": "vp test --coverage",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"fmt": "vp fmt --write",
		"check": "vp check",
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@types/node": "^26.5.1",
		"@ver0/oxlint-config": "^2.0.2",
		"@vitest/browser-playwright": "4.1.11",
		"@vitest/coverage-v8": "4.1.11",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"playwright": "^1.63.0",
		"rimraf": "^6.1.3",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2",
		"vite-plus": "^0.3.2"
	},
	"packageManager": "yarn@4.18.0"
}
